# Application
APP_NAME=ATLAS
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=atlas
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false
DATABASE_SSL_MODE=prefer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# AI Providers
AI_DEFAULT_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_TIMEOUT=120
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=
AI_OPENAI_ORGANIZATION=
AI_OPENAI_TIMEOUT=60
AI_OPENAI_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-large
AI_EMBEDDING_DIMENSIONS=3072
AI_EMBEDDING_PROVIDER=openai
AI_RERANK_PROVIDER=openai
AI_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=8192

# Vector Database
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
VECTOR_DB_USERNAME=postgres
VECTOR_DB_PASSWORD=postgres
VECTOR_DB_DATABASE=atlas
VECTOR_DB_INDEX_NAME=atlas_embeddings
VECTOR_DB_DIMENSION=3072
VECTOR_DB_METRIC=cosine

# Storage
STORAGE_PROVIDER=s3
STORAGE_BUCKET=atlas-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_CDN_URL=
STORAGE_MAX_FILE_SIZE=52428800

# Email
EMAIL_PROVIDER=sendgrid
EMAIL_FROM_EMAIL=noreply@atlas.example.com
EMAIL_FROM_NAME=ATLAS
EMAIL_SENDGRID_API_KEY=
EMAIL_SES_REGION=us-east-1
EMAIL_SES_ACCESS_KEY=
EMAIL_SES_SECRET_KEY=
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true

# Authentication
AUTH_SECRET_KEY=change-me-in-production-min-32-chars
AUTH_ALGORITHM=RS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=90
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true
AUTH_BCRYPT_ROUNDS=12
AUTH_JWT_ISSUER=atlas
AUTH_JWT_AUDIENCE=atlas-api
AUTH_PRIVATE_KEY_PATH=./keys/private_key.pem
AUTH_PUBLIC_KEY_PATH=./keys/public_key.pem
AUTH_MFA_ISSUER=ATLAS
AUTH_MFA_WINDOW=1
AUTH_SESSION_TIMEOUT_MINUTES=60
AUTH_MAX_SESSIONS_PER_USER=5
AUTH_PASSWORD_HISTORY_COUNT=5
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
CORS_EXPOSE_HEADERS=["*"]
CORS_MAX_AGE=600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_REGISTER_LIMIT=3
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_API_LIMIT=1000
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_AI_LIMIT=50
RATE_LIMIT_AI_WINDOW=60
RATE_LIMIT_UPLOAD_LIMIT=10
RATE_LIMIT_UPLOAD_WINDOW=3600

# Monitoring
MONITORING_ENABLED=true
MONITORING_SENTRY_DSN=
MONITORING_SENTRY_ENVIRONMENT=development
MONITORING_SENTRY_TRACES_SAMPLE_RATE=0.1
MONITORING_SENTRY_PROFILES_SAMPLE_RATE=0.1
MONITORING_PROMETHEUS_ENABLED=true
MONITORING_PROMETHEUS_PORT=9090
MONITORING_HEALTH_CHECK_INTERVAL=30
MONITORING_LOG_LEVEL=INFO
MONITORING_LOG_FORMAT=json
MONITORING_LOG_FILE=
MONITORING_LOG_MAX_SIZE=104857600
MONITORING_LOG_BACKUP_COUNT=10

# Feature Flags
FEATURE_AI_RECRUITER=true
FEATURE_SEMANTIC_SEARCH=true
FEATURE_INTERVIEW_INTELLIGENCE=true
FEATURE_WORKFLOW_AUTOMATION=true
FEATURE_ANALYTICS=true
FEATURE_ENTERPRISE_ADMIN=true
FEATURE_VIDEO_INTERVIEWS=true
FEATURE_VOICE_AI=true
FEATURE_SEMANTIC_SEARCH_EMBEDDINGS=true
FEATURE_RERANKING=true
FEATURE_VECTOR_SEARCH=true
FEATURE_WORKFLOW_BUILDER=true
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_ENTERPRISE_SSO=true
FEATURE_AUDIT_LOGS=true
FEATURE_WEBHOOKS=true
FEATURE_WEBHOOKS_RETRY=true
FEATURE_API_RATE_LIMITING=true
FEATURE_API_VERSIONING=true