# ─── ATLAS Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your keys

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/atlas

# ── AI Provider (gemini | ollama) ─────────────────────────────────────────────
AI_PROVIDER=gemini

# ── Google Gemini API Key ─────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=DOCKER_SECURE_JWT_KEY_GENERATED_FOR_PRODUCTION_SESSION_DEPLOYMENT

# ── Ollama (fallback, optional) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
FAISS_INDEX_PATH=/app/vector/vector_index.faiss
